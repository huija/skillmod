msgstr "不支持的平台 %q，当前支持: %s"

msgid "update [names…]"
msgstr "update [名称…]"

#, go-format
msgid "update requires network access to resolve the latest version: %w"
msgstr "update 需要联网解析最新版本: %w"

msgid "upgrade available → "
msgstr "可升级 → "

msgid "verification result: all entries are consistent"
msgstr "校验结论：全部一致"

msgid "verification result: drift detected"
msgstr "校验结论：有漂移"

msgid "verify every installation against SKILL.lock (read-only, with CI-friendly exit codes)"
msgstr "全量校验安装状态与 SKILL.lock 是否一致（只读，CI 消费退出码）"

msgid "verify without modifying anything (alias for skillmod verify)"
msgstr "只校验不修改（skillmod verify 的别名）"

#, go-format
msgid "version %q does not exist. Available tags (descending semver order, up to 10): %s"
msgstr "版本 %q 不存在。可用 tag（semver 降序，最多 10 个）: %s"

#, go-format
msgid "version %q does not exist; this repository/subdirectory has no available tags"
msgstr "版本 %q 不存在，该仓库/子目录没有任何可用 tag"

#, go-format
msgid "version changed %s → %s (manual mod edit triggered re-resolution)"
msgstr "版本变化 %s → %s（mod 手改触发重解析）"

msgid "version directory cannot be verified: "
msgstr "版本目录无法校验: "

msgid "version directory is unreadable: "
msgstr "版本目录不可读: "

#, go-format
msgid "version is not a canonical semver or pseudo-version: %q"
msgstr "版本不是规范 semver/伪版本: %q"

msgid "version metadata is unreadable: "
msgstr "版本元数据不可读: "

#, go-format
msgid "version metadata repository identity mismatch: %s"
msgstr "版本元数据 repo 身份不匹配: %s"

#, go-format
msgid "version metadata version does not match its file name: %s"
msgstr "版本元数据 version 与文件名不匹配: %s"

#, go-format
msgid "version reference contains whitespace: %q"
msgstr "版本引用含空白字符: %q"

#, go-format
msgid "version snapshot conflict; refusing to overwrite %s\nexisting:  %s @ %s (%s)\nrequested: %s @ %s (%s)\nPossible cause: the remote tag moved or the contents of the same version were rewritten"
msgstr "版本快照冲突，拒绝覆盖 %s\n已有: %s @ %s (%s)\n请求: %s @ %s (%s)\n可能原因：远端 tag 被移动或同一版本内容被改写"

#, go-format
msgid "version snapshot contains an irregular file: %s"
msgstr "版本快照含非常规文件: %s"

#, go-format
msgid "write %s: %w"
msgstr "写 %s: %w"

#, go-format
msgid "writing to disk failed: %w"
msgstr "落盘失败: %w"

